# ==========================================
# SHIPMENTS API TESTS
# ==========================================

### MIGRATION VERIFICATION: Get all shipments to verify "AwaitingPickup" status
### After applying migration 20251223101600_FixShipmentStatusEnumValues
### All shipments with status=2 should show "status": "AwaitingPickup" in JSON response
### NO shipments should show "status": "ReadyToCollect"
GET {{Backend.Api_HostAddress}}/api/Shipments?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}
Accept: application/json

###

### Get all shipments (with pagination and filters)
GET {{Backend.Api_HostAddress}}/api/Shipments?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}
Accept: application/json

###

### Get shipment by ID
GET {{Backend.Api_HostAddress}}/api/Shipments/11
Authorization: Bearer {{token}}
Accept: application/json

###

### Get products for a specific shipment
GET {{Backend.Api_HostAddress}}/api/Shipments/2/products
Authorization: Bearer {{token}}
Accept: application/json

###

### Create a new shipment (InPreparation status - no required fields)
POST {{Backend.Api_HostAddress}}/api/Shipments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": 1,
  "status": 1,
  "description": "Test shipment in preparation",
  "sendDate": null,
  "deliveryDate": null,
  "weight": null,
  "length": null,
  "width": null,
  "height": null,
  "senderName": null,
  "senderTaxId": null,
  "senderAddressId": null,
  "senderDetails": null,
  "receiverName": null,
  "receiverTaxId": null,
  "receiverAddressId": null,
  "receiverDetails": null
}

###

### Update shipment status - WILL FAIL if required fields missing
### This will return 409 Conflict with error message when trying to change to AwaitingPickup
PATCH {{Backend.Api_HostAddress}}/api/Shipments/11/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": 2
}

###

### Update full shipment (fill in required fields before status change)
PUT {{Backend.Api_HostAddress}}/api/Shipments/11
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": 1,
  "status": 1,
  "sendDate": "2025-12-16T10:00:00Z",
  "deliveryDate": null,
  "description": "Updated shipment with all required fields",
  "weight": 5.5,
  "length": 30.0,
  "width": 20.0,
  "height": 15.0,
  "senderName": "Warehouse ABC",
  "senderTaxId": "1234567890",
  "senderAddressId": 1,
  "senderDetails": "Building A, Dock 5",
  "receiverName": "Customer XYZ",
  "receiverTaxId": "0987654321",
  "receiverAddressId": 2,
  "receiverDetails": "Apartment 42, Ring bell twice"
}

###

### Update shipment status - NOW WILL SUCCEED after required fields are filled
### Status transitions for OUTGOING shipments:
### 1 (InPreparation) → 2 (AwaitingPickup) → 3 (InTransit) → 4 (Delivered)
PATCH {{Backend.Api_HostAddress}}/api/Shipments/11/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": 2
}

###

### Transition to InTransit (status 3)
### Used by status transition button: AwaitingPickup → InTransit
PATCH {{Backend.Api_HostAddress}}/api/Shipments/11/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": 3
}

###

### Transition to Delivered (status 4)
### Used by status transition button: InTransit → Delivered
PATCH {{Backend.Api_HostAddress}}/api/Shipments/11/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": 4
}

###

### Add products to shipment
POST {{Backend.Api_HostAddress}}/api/Shipments/11/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "products": [
    {
      "productId": 1,
      "quantity": 10
    },
    {
      "productId": 2,
      "quantity": 5
    }
  ]
}

###

### Remove products from shipment
DELETE {{Backend.Api_HostAddress}}/api/Shipments/11/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productIds": [1, 2]
}

###

### Delete shipment
DELETE {{Backend.Api_HostAddress}}/api/Shipments/11
Authorization: Bearer {{token}}

###

### Complete collection (incoming shipment only)
### This will create ShipmentProductCollection records, update inventory, and change status to Collected (2)
POST {{Backend.Api_HostAddress}}/api/Shipments/11/complete-collection
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "collectedProducts": [
    {
      "productId": 1,
      "locationId": 1,
      "declaredQuantity": 10,
      "collectedQuantity": 10
    },
    {
      "productId": 2,
      "locationId": 2,
      "declaredQuantity": 5,
      "collectedQuantity": 4
    }
  ]
}

###

### Get shipment product collection data (for collected shipments)
### Returns grouped collection data with declared vs collected quantities and variance
GET {{Backend.Api_HostAddress}}/api/Shipments/11/collection
Authorization: Bearer {{token}}
Accept: application/json

###

### Get shipment product preparation data (for outgoing/leaving shipments)
### Returns grouped preparation data with source locations, quantities taken, and quantities left
GET {{Backend.Api_HostAddress}}/api/Shipments/2/preparation
Authorization: Bearer {{token}}
Accept: application/json

###

# ==========================================
# LEAVING SHIPMENTS (OUTGOING) - ADD/EDIT TESTS
# ==========================================

### Create a new leaving shipment (type: 2 = Outgoing/Leaving)
### Note: Dimensions (weight, length, width, height) are null - set during preparation
### Sender is the store, Receiver is the customer
POST {{Backend.Api_HostAddress}}/api/Shipments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": 2,
  "status": 1,
  "sendDate": "2025-12-25T10:00:00Z",
  "deliveryDate": "2025-12-28T14:00:00Z",
  "description": "Customer order #12345 - Electronics",
  "weight": null,
  "length": null,
  "width": null,
  "height": null,
  "senderName": "Main Store",
  "senderTaxId": "1234567890",
  "senderAddressId": 1,
  "senderDetails": "Main Street 123, 00-950 Warszawa, Poland",
  "receiverName": "John Doe",
  "receiverTaxId": "9876543210",
  "receiverAddressId": 2,
  "receiverDetails": "Apartment 5B, Floor 3"
}

###

### Update leaving shipment (edit mode)
### Can only edit when status is InPreparation (status: 1)
PUT {{Backend.Api_HostAddress}}/api/Shipments/11
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": 2,
  "status": 1,
  "sendDate": "2025-12-26T09:00:00Z",
  "deliveryDate": "2025-12-29T16:00:00Z",
  "description": "Updated customer order #12345 - Electronics + Accessories",
  "weight": null,
  "length": null,
  "width": null,
  "height": null,
  "senderName": "Main Store",
  "senderTaxId": "1234567890",
  "senderAddressId": 1,
  "senderDetails": "Main Street 123, 00-950 Warszawa, Poland",
  "receiverName": "John Doe",
  "receiverTaxId": "9876543210",
  "receiverAddressId": 3,
  "receiverDetails": "New address: Building C, Office 101"
}

