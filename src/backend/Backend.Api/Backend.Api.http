# ==========================================
# LEAVING SHIPMENT PREPARATION API TESTS
# ==========================================

### Save preparation progress (isFinishing: false)
### Allows partial quantities, dimensions optional, status stays InPreparation
POST {{Backend.Api_HostAddress}}/api/Shipments/11/complete-preparation
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isFinishing": false,
  "preparedProducts": [
    {
      "productId": 1,
      "sourceLocations": [
        {
          "locationId": 1,
          "quantity": 5
        }
      ]
    },
    {
      "productId": 2,
      "sourceLocations": [
        {
          "locationId": 2,
          "quantity": 3
        },
        {
          "locationId": 3,
          "quantity": 2
        }
      ]
    }
  ],
  "weight": 2.5,
  "length": 30.0,
  "width": 20.0,
  "height": 15.0
}

###

### Finish preparation (isFinishing: true)
### Requires all dimensions, validates quantities match manifest, changes status to AwaitingPickup
POST {{Backend.Api_HostAddress}}/api/Shipments/11/complete-preparation
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isFinishing": true,
  "preparedProducts": [
    {
      "productId": 1,
      "sourceLocations": [
        {
          "locationId": 1,
          "quantity": 10
        }
      ]
    },
    {
      "productId": 2,
      "sourceLocations": [
        {
          "locationId": 2,
          "quantity": 3
        },
        {
          "locationId": 3,
          "quantity": 2
        }
      ]
    }
  ],
  "weight": 5.5,
  "length": 50.0,
  "width": 30.0,
  "height": 25.0
}

###

### Finish preparation - WILL FAIL if dimensions missing
POST {{Backend.Api_HostAddress}}/api/Shipments/11/complete-preparation
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isFinishing": true,
  "preparedProducts": [
    {
      "productId": 1,
      "sourceLocations": [
        {
          "locationId": 1,
          "quantity": 10
        }
      ]
    }
  ],
  "weight": 5.5
  // Missing length, width, height - should return 400 Bad Request
}

###

### Finish preparation - WILL FAIL if quantities don't match manifest
### Assumes product 1 has manifest quantity of 10 units
POST {{Backend.Api_HostAddress}}/api/Shipments/11/complete-preparation
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isFinishing": true,
  "preparedProducts": [
    {
      "productId": 1,
      "sourceLocations": [
        {
          "locationId": 1,
          "quantity": 7
        }
      ]
    }
  ],
  "weight": 5.5,
  "length": 50.0,
  "width": 30.0,
  "height": 25.0
  // Should return 409 Conflict: "Total prepared quantity (7) does not match manifest quantity (10)"
}

###

### Get shipment product preparation data (for shipments being prepared)
### Returns grouped preparation data with source locations
GET {{Backend.Api_HostAddress}}/api/Shipments/11/preparation
Authorization: Bearer {{token}}
Accept: application/json

